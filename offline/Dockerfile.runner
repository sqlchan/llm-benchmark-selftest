# 评测 runner 镜像（模板）
# 构建（在仓库根目录）：docker build -f offline/Dockerfile.runner -t bench-eval-runner:local .
#
# 说明：
# - 只装工具链，不烘焙数据；数据由 docker-compose 挂载（离线，无需联网）。
# - 版本号为 2026-10-30 调研值，安装前请核对 PyPI（TODO verify）。
# - 需要 Python 3.12：Harbor/Pier/ALE 要求 >=3.12；Ubuntu 24.04 默认 3.12。
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_OFFLINE=1 \
    PIP_NO_INDEX=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git jq unzip xz-utils zstd \
        python3 python3-pip python3-venv \
        docker.io \
    && rm -rf /var/lib/apt/lists/*

# uv（提供隔离的 Python 环境；Harbor/Pier 需要 3.12）
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# 官方 harness（TODO verify：版本号按 PyPI 实际可用版本调整）
RUN uv tool install harbor==0.25.0 \
 && uv tool install datacurve-pier==0.3.1 \
 && uv tool install mini-swe-agent==2.4.6

# 通用框架与工具
RUN pip3 install --break-system-packages --no-cache-dir \
        "evalscope==1.14.1" \
        "inspect-ai==0.3.286" \
        "inspect-evals==0.27.0" \
        "huggingface_hub[cli]" \
        openpyxl

# 评测脚本（仓库根目录为 build context）
COPY offline/run_stage1.sh /workspace/offline/run_stage1.sh
RUN chmod +x /workspace/offline/run_stage1.sh

WORKDIR /workspace
# 用宿主机的 docker.sock 跑任务容器（docker-outside-of-docker），容器内不启动 dockerd
CMD ["sleep", "infinity"]
