# 模型端点配置模板（复制为 company.env / home.env 后填写；真实 key 不要提交 git）
# 用途：docker compose --env-file offline/env/company.env up -d

# ===== 通用（OpenAI 兼容端点）=====
OPENAI_API_BASE=http://host.docker.internal:8080/v1
OPENAI_API_KEY=REPLACE_ME
MODEL_NAME=your-model-name

# 可选：推理强度 / 采样（各 harness 参数不同，按需使用）
# REASONING_EFFORT=medium
# TEMPERATURE=1.0
# TOP_P=1.0

# ===== 家里自测用：火山方舟（Ark）=====
# 已实测（2026-10-31）：OpenAI 兼容 base 是 /api/plan/v1（/api/v3 会 401）
# OPENAI_API_BASE=https://ark.cn-beijing.volces.com/api/plan/v1
# OPENAI_API_KEY=<ARK_API_KEY>
# MODEL_NAME=deepseek-v4-flash
# 另一候选：glm-5.3-flash（推理型，注意给足 max_tokens）

# ===== 公司内网：只有宿主机能访问时 =====
# 宿主机起反向代理（如 nginx: 8080 -> 内网 model 网关），容器用 host.docker.internal 访问
# OPENAI_API_BASE=http://host.docker.internal:8080/v1

# ===== 基准子集/数据版本（manifest 里也记录一份）=====
# PROGRAMBENCH_SLICE=0:5
# DEEPSWE_N_TASKS=10
# AUTOMATION_DOMAINS=simple

# ===== 并发预设（按宿主机规格；文件在 offline/config/）=====
# run_batch2.sh 会在 source 本文件后，再按 PROFILE 叠加 offline/config/<profile>.env
# （同名变量以后者为准）。公司 32C/64G 机器直接用：
#   ./offline/run_batch2_32c64g.sh tb4|oracle|nl2repo      # 等价 PROFILE=32c64g
# 本文件只放端点/模型；并发参数放 profile，不要把 profile 的内容抄回来。
# 详见 offline/config/README.md 与 report/company-32c64g-concurrency.md。

# ===== 第二批：Terminal-Bench 4.0 =====
# TB4_TASKS=bun-sourcemap-leak,html-js-filter     # 逗号分隔；不填=全部 36 题
# TB4_N_CONCURRENT=2                              # 公司 32C/64G：profile 32c64g 设为 3
# TB4_AGENT_TIMEOUT_MULTIPLIER=0.05               # 冒烟 5%；正式评估建议 1.0（官方 8h/题）
# TB4_ORACLE=1                                    # 只跑 oracle 自检（不需要模型）

# ===== 第二批：NL2Repo-Bench =====
# NL2REPO_TASKS=aiofiles,humanize,sqlparse        # 逗号分隔；默认 3 题
# NL2REPO_MAX_POOL=1                              # 默认串行=1；公司 32C/64G 用 profile 设为 3（需并行补丁）
# NL2REPO_MAX_ITERATIONS=500                      # 官方模板默认；冒烟可调小
# NL2REPO_PORT_BASE=3000                          # app 端口基数；3000 被占时整段后移
# NL2REPO_CLEANUP=1                               # 可选：启动前清本批次残留 openhands-app-*/python-test-* 容器
