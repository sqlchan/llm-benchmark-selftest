# TB4 派生任务镜像：预装离线 agent 工具链（uv + CPython 3.12 + mini-swe-agent + wheel 缓存）
# 构建上下文 = sandbox/batch2/payload（含 tb4-agent-payload.tar.gz 与 uv）
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root
COPY tb4-agent-payload.tar.gz /tmp/tb4-agent-payload.tar.gz
COPY uv /usr/local/bin/uv

RUN set -eux; \
    chmod 0755 /usr/local/bin/uv; \
    tar xzf /tmp/tb4-agent-payload.tar.gz -C /; \
    rm -f /tmp/tb4-agent-payload.tar.gz; \
    ln -sf /opt/tb4-agent/bin/mini-swe-agent /usr/local/bin/mini-swe-agent; \
    chmod -R a+rX /opt/tb4-agent

ENV UV_CACHE_DIR=/opt/tb4-agent/uv-cache \
    UV_PYTHON_INSTALL_DIR=/opt/tb4-agent/python \
    UV_TOOL_DIR=/opt/tb4-agent/tools \
    UV_TOOL_BIN_DIR=/opt/tb4-agent/bin \
    UV_OFFLINE=1
