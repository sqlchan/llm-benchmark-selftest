# ============================================================================
# 32C / 64GB 公司 Linux 宿主机：第二批并发预设（PROFILE=32c64g）
# ----------------------------------------------------------------------------
# 用法（二选一）：
#   ./offline/run_batch2_32c64g.sh tb4|oracle|nl2repo|shell    # 推荐：wrapper 自动 export PROFILE
#   PROFILE=32c64g ./offline/run_batch2.sh tb4                  # 等价写法
#
# 加载顺序（run_batch2.sh 的 PROFILE 补丁）：先 source offline/env/company.env，
# 再 source 本文件 → 本文件里的同名变量覆盖 company.env。
# 本文件只放「资源与并发」参数，不放 API key / 内网端点（那些在 company.env）。
#
# 机器事实：32 vCPU / 64GB RAM / 1TB 盘，Linux + Docker（离线），模型走内网
# OpenAI 兼容端点。容量/工期/降级规则的完整推导见
# report/company-32c64g-concurrency.md（会同步进离线包 docs/）。
# ============================================================================

# ----- Terminal-Bench 4.0（Harbor，36 题；走 run_batch2.sh）---------------
# 并发 trial 数。36 题声明资源的单题内存上限是 16GB（只有 1 题），按最坏叠加
# 「N × 16GB + 8GB（OS/Docker/runner 基线）」：n=2≈40GB、n=3≈56GB、n=4≈72GB
# > 64GB，故默认 3。出现 OOM / 宿主 free < 6GB / dmesg 有 oom-kill 时退到 2
# （最低 1），不要靠降超时赶工。
TB4_N_CONCURRENT=3

# 单题 agent 超时倍数：1.0 = 官方单题预算 8 小时（task.toml [agent]
# timeout_sec=28800）。正式跑必须显式设为 1.0：脚本默认 0.05 是冒烟值，
# 会把题全部截断、分数不可比。时间不够用 TB4_TASKS 分晚跑，不要降这个值。
# 冒烟想用 0.05 时不要经过 wrapper（profile 会覆盖成 1.0），直接：
#   TB4_TASKS=html-js-filter TB4_AGENT_TIMEOUT_MULTIPLIER=0.05 TB4_N_CONCURRENT=1 \
#     ./offline/run_batch2.sh tb4
TB4_AGENT_TIMEOUT_MULTIPLIER=1.0

# 可选：只跑指定题（逗号分隔；不填 = 全部 36 题）。
# 正式跑前先做 oracle 自检，剔除环境不通的题（oracle 都不过的题 agent 也过不了）：
#   ./offline/run_batch2_32c64g.sh oracle
# TB4_TASKS=html-js-filter,live-database-cutover

# ----- NL2Repo-Bench（OpenHands，10 题；走 run_batch2.sh）-----------------
# 同时并发的任务数（harness 的 max_pool_size）。单任务 app+runtime 约 2–4GB，
# pool=3 合计约 6–12GB；app 端口 = NL2REPO_PORT_BASE + 任务序号，pool=3 占
# 3000/3001/3002。依赖 offline/nl2repo-harness/ 的并行补丁 + run_batch2.sh 的
# PROFILE 补丁（本批）。
NL2REPO_MAX_POOL=3

# 单题最大交互轮数（写入 harness 模板 max_iterations）。官方模板默认 500；
# 冒烟验证链路时可临时调 8（分数无意义），正式跑保持 500 否则结果不可比。
# 冒烟时不要经过 wrapper（profile 会覆盖成 500），直接：
#   NL2REPO_TASKS=aiofiles NL2REPO_MAX_ITERATIONS=8 ./offline/run_batch2.sh nl2repo
NL2REPO_MAX_ITERATIONS=500

# 端口基数：3000 被占（上一轮残留 openhands 容器/其他服务）时整段后移，
# 例如 3100（pool=3 → 3100/3101/3102）。
NL2REPO_PORT_BASE=3000

# 正式跑的 10 题（与离线包 manifest 的 nl2repo.task_list 一致；不填时
# run_batch2_inner.sh 默认只跑 aiofiles,humanize,sqlparse 3 题）。
NL2REPO_TASKS=aiofiles,humanize,sqlparse,tenacity,cerberus,tinydb,markupsafe,jsonlines,freezegun,python-slugify

# 可选：启动前清理残留 openhands-app-* / python-test-* 容器（并行补丁提供的
# 开关，默认关闭）。不想自动删容器就保持注释，冲突时手动 docker rm -f。
# NL2REPO_CLEANUP=1

# ============================================================================
# 以下基准不走 run_batch2.sh，参数只作命令参考（写在这里避免现场翻文档）
# ----------------------------------------------------------------------------
# Automation-Bench（纯 API、无任务容器；瓶颈是内网端点 QPS/TPM，不是本机
# CPU/内存）：uv run auto-bench --domains sales --num-examples 100
#   --max-concurrent 5
# 建议 5；出现持续的 429/超时（而不是平稳变慢）时降到 3。sales 单域 100 题
# 参考 report/company-day1-checklist.md 的第一步；600 题全量也先按 5 起步。
#
# ProgramBench（单题重、要起评测容器；离线包 3 题）：
#   mini-extra programbench --model "$MODEL_NAME" --filter "<实例名>" --workers 1 -c <config>
# 建议串行 --workers 1。ProgramBench 默认请求 20C/60GB，必须用 run_args 覆盖
# （离线包已修：去掉 --cpus/--memory，见 report/first-batch-bundle.md §7/§8），
# 否则 32C/64G 机器上仍会因 20C/60G 的资源申请失败。
#
# DeepSWE（Pier + mini-swe-agent，10 题）：用
# offline/deepswe-pier-32c64g.yaml，n_concurrent_trials=3（每 trial 2C/8GB，
# 峰值约 6C/24GB），agent_timeout_multiplier=1.0。3 并发跑 DeepSWE 时不要
# 同时跑 TB4/NL2Repo（内存与 Docker 前缀容器会互相干扰）。
# ============================================================================
