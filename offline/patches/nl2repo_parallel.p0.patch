+DEFAULT_PORT_BASE = 3000
+
+
+def _env_int(name: str, default: int) -> int:
+    """Read an integer environment variable, warn + fall back on bad values."""
+    raw = os.environ.get(name)
+    if raw is None or str(raw).strip() == "":
+        return default
+    try:
+        return int(str(raw).strip())
+    except ValueError:
+        logger.warning(f"环境变量 {name}={raw!r} 不是整数，使用默认值 {default}")
+        return default
+
+
+_TRUE_VALUES = ("1", "true", "yes", "on")
+
+
+def _as_bool(value) -> bool:
+    if isinstance(value, bool):
+        return value
+    return str(value).strip().lower() in _TRUE_VALUES
+
+
+def _resolve_port_base(config: dict) -> int:
+    """端口基数：config.json 的 port_base > 环境变量 NL2REPO_PORT_BASE > 3000。"""
+    if config.get("port_base") not in (None, ""):
+        try:
+            return int(config["port_base"])
+        except (TypeError, ValueError):
+            logger.warning(f"config.json 中 port_base={config.get('port_base')!r} 不是整数，回退到环境变量")
+    return _env_int("NL2REPO_PORT_BASE", DEFAULT_PORT_BASE)
+
+
+def _resolve_cleanup(config: dict) -> bool:
+    """是否在启动前清理残留容器：config.json 的 cleanup > 环境变量 NL2REPO_CLEANUP > 关闭。"""
+    if config.get("cleanup") is not None:
+        return _as_bool(config["cleanup"])
+    raw = os.environ.get("NL2REPO_CLEANUP")
+    if raw is None or str(raw).strip() == "":
+        return False
+    return _as_bool(raw)
+
