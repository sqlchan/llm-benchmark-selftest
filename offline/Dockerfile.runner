# 评测 runner 镜像（仓库版模板；第一批实测版本见离线包/ first-batch-bundle.md）
# 构建（在仓库根目录）：docker build -f offline/Dockerfile.runner -t bench-eval-runner:local .
#
# 说明：
# - 只装工具链，不烘焙数据；数据由 docker-compose 挂载（离线，无需联网）。
# - 需要 Python 3.12：Harbor/Pier/ALE 要求 >=3.12；Ubuntu 24.04 默认 3.12。
# - 实测坑（2026-10-31）：
#   * 容器内 pip 不可用（返回 no versions），全部改用 uv
#   * mini-extra programbench 需要 programbench 与 mini-swe-agent 在同一环境（--with）
#   * LiteLLM 1.106 + mini-swe 需要 mcp 包，否则 ModuleNotFoundError
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_OFFLINE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git jq unzip xz-utils zstd \
        python3 python3-pip python3-venv \
        docker.io docker-compose-v2 \
    && rm -rf /var/lib/apt/lists/*

# uv（提供隔离的 Python 环境；Harbor/Pier 需要 3.12）
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# 官方 harness（版本为 2026-10-30 实测值）
RUN uv tool install harbor==0.25.0 \
 && uv tool install datacurve-pier==0.3.1 \
 && uv tool install mini-swe-agent==2.4.6 --with programbench==1.2.5 --with mcp \
 && uv tool install programbench==1.2.5

# 评测脚本（仓库根目录为 build context）
COPY offline/run_stage1.sh /workspace/offline/run_stage1.sh
RUN chmod +x /workspace/offline/run_stage1.sh

WORKDIR /workspace
# 用宿主机的 docker.sock 跑任务容器（docker-outside-of-docker），容器内不启动 dockerd
CMD ["sleep", "infinity"]
