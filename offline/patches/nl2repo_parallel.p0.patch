+def cleanup_stale_containers(task_list) -> None:
+    """清理上一轮中断运行遗留的本批次容器（对应 ``NL2REPO_CLEANUP=1``）。
+
+    只按「本批次任务计算出的精确容器名」清理，不会误删：
+    - 其他 harness 进程的容器（端口基数不同 → 名字不同）；
+    - 用户自己的容器。
+    清理对象为 app 容器（--rm 残留，例如 docker 守护进程重启/进程被 kill）
+    和 post-process 测试容器（``python-test-<task_uuid>``）。
+    """
+    targets = set()
+    for app_data in task_list:
+        for pro_name in app_data.pro_name_list:
+            targets.add(f"python-test-{pro_name}_bo{app_data.bo_size}")
+        targets.add(f"openhands-app-{app_data.port}")
+    if not targets:
+        return
+
+    logger.info(f"NL2REPO_CLEANUP 已开启：检查 {len(targets)} 个本批次残留容器名: {sorted(targets)}")
+    try:
+        client = create_docker_client(get_local_host_info())
+        containers = client.container.list(all=True)
+    except Exception as e:
+        logger.warning(f"列出容器失败，跳过残留清理: {e}")
+        return
+
+    removed = 0
+    for container in containers:
+        try:
+            name = container.name
+        except Exception:
+            continue
+        if name not in targets:
+            continue
+        try:
+            logger.warning(f"清理残留容器: {name} (id={container.id})")
+            client.container.remove(container, force=True, volumes=True)
+            removed += 1
+        except Exception as e:
+            logger.warning(f"清理残留容器失败: {name}: {e}")
+    logger.info(f"NL2REPO_CLEANUP 完成：本次清理 {removed} 个残留容器")
+
